/// Author: Caleb Gyamfi – Omnixys Technologies
/// ----------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["event"]
}

//
// ──────────────────────────────────────────────────────────
// EVENT ROOT
// ──────────────────────────────────────────────────────────

model Event {
  id    String @id @default(uuid()) @map("id") @db.Uuid
  name  String
  owner String

  parentId String? @db.Uuid
  parent   Event?  @relation("EventHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Event[] @relation("EventHierarchy")
  path     String  @default("") @map("path")
  depth    Int     @default(0)

  coverMediaId String? @map("cover_image_id") @db.Uuid
  logoMediaId  String? @map("logo_media_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings  Settings?
  analytics Analytics?
  timelines Timeline[]
  roles     Role[]

  media Media[] @relation("EventMedia")

  coverMedia Media? @relation("EventCover", fields: [coverMediaId], references: [id])
  logoMedia  Media? @relation("EventLogo",  fields: [logoMediaId],  references: [id])

  @@index([parentId])
  @@map("event")
  @@schema("event")
}

model Settings {
  id String @id @default(uuid()) @map("id") @db.Uuid

  eventId String @unique @db.Uuid
  event   Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  allowReEntry  Boolean @default(true) @map("allow_re_entry")
  rotateSeconds Int     @default(300) @map("rotate_seconds")
  maxSeats      Int     @default(10) @map("max_seats")

  allowPublicRsvp        Boolean @default(true) @map("allow_public_rsvp")
  allowPublicPlusOne     Boolean @default(true) @map("allow_public_plus_one")
  allowPublicRsvpWebsite Boolean @default(false) @map("allow_public_rsvp_website")
  allowPlusOneUpdate     Boolean @default(false) @map("allow_plus_one_update")

  approvalMode InvitationApprovalMode @default(MANUAL)
  allowGuestSeatSelection Boolean @default(false) @map("allow_guest_seat_selection")

  maxPlusOnes Int @default(0) @map("max_plus_ones")
  requireApprovalForPlusOnes Boolean @default(true) @map("require_approval_for_plus_ones")
  rsvpDeadline DateTime? @map("rsvp_deadline")
  allowSeatOverbooking Boolean @default(false) @map("allow_seat_overbooking")

  publicRsvpWebsite String? @map("public_rsvp_website")

  isActive Boolean @default(true) @map("is_active")
  isPublic Boolean @default(false) @map("is_public")

  dressCode   String? @map("dress_code")
  description String? @map("description")

  startsAt DateTime
  endsAt   DateTime

  category EventCategory @default(GENERAL) @map("category")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("event")
}

//
// ──────────────────────────────────────────────────────────
// ANALYTICS SNAPSHOT
// ──────────────────────────────────────────────────────────
//
model Analytics {
  id      String @id @default(uuid()) @map("id") @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid

  totalInvites Int @default(0) @map("total_invites")
  accepted     Int @default(0) @map("accepted")
  declined     Int @default(0) @map("declined")
  checkedIn    Int @default(0) @map("checked_in")
  inside       Int @default(0) @map("inside")
  outside      Int @default(0) @map("outside")

  lastUpdate DateTime @default(now()) @map("last_update")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_analytics")
  @@schema("event")
}

