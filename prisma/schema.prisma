//
// ──────────────────────────────────────────────────────────
// TIMELINE
// ──────────────────────────────────────────────────────────
//
model Timeline {
  id          String  @id @default(uuid()) @map("id") @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  sourceId    String? @unique @map("source_id")
  referenceId String? @map("reference_id")

  type      String   @map("type")
  timestamp DateTime @map("timestamp")
  label     String   @map("label")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_timeline")
}

//
// ──────────────────────────────────────────────────────────
// USER EVENT ROLES (local projection)
// ──────────────────────────────────────────────────────────
//
model Role {
  id      String       @id @default(uuid()) @map("id") @db.Uuid
  userId  String       @map("user_id") @db.Uuid
  eventId String       @map("event_id") @db.Uuid
  role    UserRoleType @map("role")

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userProject UserProjection? @relation("UserProjectionRoles", fields: [userId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("user_event_role")
}

enum UserRoleType {
  ADMIN
  SECURITY
  GUEST
  SUPPORT
  DRIVER
  USHER

  @@map("user_role_type")
}

model EventRoleDefinition {
  id          String              @id @default(uuid()) @map("id") @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  key         String              @map("key")
  name        String              @map("name")
  description String?             @map("description")
  color       String?             @map("color")
  icon        String?             @map("icon")
  systemKey   EventSystemRoleKey? @map("system_key")
  archivedAt  DateTime?           @map("archived_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime?           @updatedAt @map("updated_at")

  event       Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  permissions EventRolePermission[]
  assignments EventUserRoleAssignment[]

  @@unique([eventId, key])
  @@unique([eventId, systemKey])
  @@index([eventId])
  @@map("event_role")
}

model EventPermissionDefinition {
  key               String    @id @map("key")
  category          String    @map("category")
  label             String    @map("label")
  description       String    @map("description")
  premiumFeatureKey String?   @map("premium_feature_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  roles EventRolePermission[]

  @@map("event_permission")
}

model EventRolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       EventRoleDefinition       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission EventPermissionDefinition @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("event_role_permission")
}

model EventUserRoleAssignment {
  id         String    @id @default(uuid()) @map("id") @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  event Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role  EventRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  user           UserProjection? @relation("EventAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedByUser UserProjection? @relation("EventAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([eventId, userId, roleId])
  @@index([eventId, userId])
  @@index([roleId])
  @@map("event_user_role")
}

enum EventSystemRoleKey {
  ADMIN
  SECURITY
  GUEST
  DRIVER
  USHER

  @@map("event_system_role_key")
}

enum EventCategory {
  GENERAL
  KONFERENZ
  MUSIK
  WORKSHOP
  SOCIAL
  SPORTS

  @@map("event_category")
}

model Media {
  id       String @id @default(uuid()) @map("id") @db.Uuid
  key      String @unique
  url      String
  filename String
  mimetype String
  size     Int?

  type MediaType @default(GALLERY)

  eventId String @db.Uuid
  event   Event  @relation("EventMedia", fields: [eventId], references: [id], onDelete: Cascade)

  coverFor Event[] @relation("EventCover")
  logoFor  Event[] @relation("EventLogo")

  variants MediaVariant[]

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("media")
}

model MediaVariant {
  id String @id @default(uuid()) @db.Uuid

  mediaId String @db.Uuid
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  key    String
  url    String
  width  Int
  height Int
  format String

  @@unique([mediaId, width, format])
  @@index([mediaId])
  @@map("media_variant")
}

enum MediaType {
  COVER
  LOGO
  GALLERY

  @@map("media_type")
}

//
// ──────────────────────────────────────────────────────────
// SEAT COLOR GROUPS
// ──────────────────────────────────────────────────────────
//
model SeatColorGroup {
  id         String   @id @default(uuid()) @map("id") @db.Uuid
  settingsId String   @map("settings_id") @db.Uuid
  settings   Settings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  name            String                  @map("name")
  style           Json                    @map("style")
  matchType       SeatColorGroupMatchType @map("match_type")
  invitedByValues Json                    @map("invited_by_values")
  priority        Int                     @map("priority")
  order           Int                     @map("order")
  isOrphaned      Boolean                 @default(false) @map("is_orphaned")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([settingsId])
  @@map("seat_color_group")
}

enum SeatColorGroupMatchType {
  SINGLE
  CUSTOM
  ALL
  NONE

  @@map("seat_color_group_match_type")
}

enum EventVisibleTab {
  TIMELINE
  DETAILS
  MAP

  @@map("event_visible_tab")
}

//
// ──────────────────────────────────────────────────────────
// USER PROJECTION (cached user data from User-Service)
// ──────────────────────────────────────────────────────────
//
model UserProjection {
  id           String   @id @map("id") @db.Uuid
  username     String   @map("username")
  displayName  String?  @map("display_name")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  email        String?  @map("email")
  primaryPhone String?  @map("primary_phone")
  avatarUrl    String?  @map("avatar_url")
  locale       String?  @map("locale")
  lastSynced   DateTime @default(now()) @map("last_synced")

userEventRoles  Role[]                     @relation("UserProjectionRoles")
  ownedEvents     Event[]                    @relation("EventOwner")
  userAssignments EventUserRoleAssignment[]  @relation("EventAssignmentUser")
  assignedBy      EventUserRoleAssignment[]  @relation("EventAssignmentAssignedBy")

  @@map("user_projection")
}

enum InvitationApprovalMode {
  MANUAL
  AUTO
  AUTO_PUBLIC_ONLY
  AUTO_INVITE_ONLY

  @@map("invitation_approval_mode")
}
