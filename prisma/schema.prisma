/// ----------------------------------------------------------------------
/// Prisma Schema – Omnixys Event Service (Microservice Version)
/// Author: Caleb Gyamfi – Omnixys Technologies
/// ----------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

//
// ──────────────────────────────────────────────────────────
// EVENT ROOT
// ──────────────────────────────────────────────────────────

model Event {
  id    String   @id @default(uuid()) @map("id") @db.Uuid
  name  String
  owner String   @db.Uuid
  tags  String[] @default([])

  parentId String? @map("parent_id") @db.Uuid
  parent   Event?  @relation("EventHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Event[] @relation("EventHierarchy")
  path     String  @default("") @map("path")
  depth    Int     @default(0)

  coverMediaId String? @map("cover_image_id") @db.Uuid
  logoMediaId  String? @map("logo_media_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  settings  Settings?
  analytics Analytics?
  timelines Timeline[]
  roles     Role[]

  roleDefinitions     EventRoleDefinition[]
  userRoleAssignments EventUserRoleAssignment[]

  media Media[] @relation("EventMedia")

  coverMedia Media? @relation("EventCover", fields: [coverMediaId], references: [id])
  logoMedia  Media? @relation("EventLogo", fields: [logoMediaId], references: [id])

  ownerUser UserProjection? @relation("EventOwner", fields: [owner], references: [id], onDelete: Restrict)

  @@index([parentId])
  @@map("event")
}

model Settings {
  id String @id @default(uuid()) @map("id") @db.Uuid

  eventId String @unique @map("event_id") @db.Uuid
  event   Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  allowReEntry  Boolean @default(true) @map("allow_re_entry")
  rotateSeconds Int     @default(300) @map("rotate_seconds")
  maxSeats      Int     @default(10) @map("max_seats")

  allowPublicRsvp        Boolean @default(true) @map("allow_public_rsvp")
  allowPublicPlusOne     Boolean @default(true) @map("allow_public_plus_one")
  allowPublicRsvpWebsite Boolean @default(false) @map("allow_public_rsvp_website")
  allowPlusOneUpdate     Boolean @default(false) @map("allow_plus_one_update")

  approvalMode            InvitationApprovalMode @default(MANUAL) @map("approval_mode")
  allowGuestSeatSelection Boolean                @default(false) @map("allow_guest_seat_selection")

  maxPlusOnes                Int       @default(0) @map("max_plus_ones")
  requireApprovalForPlusOnes Boolean   @default(true) @map("require_approval_for_plus_ones")
  rsvpDeadline               DateTime? @map("rsvp_deadline")
  allowSeatOverbooking       Boolean   @default(false) @map("allow_seat_overbooking")

  publicRsvpWebsite String?           @map("public_rsvp_website")
  invitedByOptions  String[]          @default([]) @map("invited_by_options")
  visibleTabs       EventVisibleTab[] @default([TIMELINE, DETAILS, MAP]) @map("visible_tabs")

  isActive Boolean @default(true) @map("is_active")
  isPublic Boolean @default(false) @map("is_public")

  dressCode   String? @map("dress_code")
  description String? @map("description")

  scheduleTicketRelease Boolean   @default(false) @map("schedule_ticket_release")
  ticketReleaseAt       DateTime? @map("ticket_release_at")

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  category EventCategory @default(GENERAL) @map("category")

  seatColorGroups SeatColorGroup[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("settings")
}

//
// ──────────────────────────────────────────────────────────
// ANALYTICS SNAPSHOT
// ──────────────────────────────────────────────────────────
//
model Analytics {
  id      String @id @default(uuid()) @map("id") @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid

  totalInvites Int @default(0) @map("total_invites")
  accepted     Int @default(0) @map("accepted")
  declined     Int @default(0) @map("declined")
  checkedIn    Int @default(0) @map("checked_in")
  inside       Int @default(0) @map("inside")
  outside      Int @default(0) @map("outside")

  lastUpdate DateTime @default(now()) @map("last_update")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_analytics")
}

model AnalyticsOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  topic          String
  payload        Json
  correlationId  String?   @map("correlation_id")
  actorId        String?   @map("actor_id")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  publishedAt    DateTime? @map("published_at")
  deadLetteredAt DateTime? @map("dead_lettered_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, deadLetteredAt, nextAttemptAt])
  @@map("analytics_outbox")
}

