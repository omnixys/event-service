//
// ──────────────────────────────────────────────────────────
// TIMELINE
// ──────────────────────────────────────────────────────────
//
model Timeline {
  id      String @id @default(uuid()) @map("id") @db.Uuid
  eventId String @map("event_id") @db.Uuid

  type      String   @map("type")
  timestamp DateTime @map("timestamp")
  label     String   @map("label")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_timeline")
  @@schema("event")
}

//
// ──────────────────────────────────────────────────────────
// USER EVENT ROLES (local projection)
// ──────────────────────────────────────────────────────────
//
model Role {
  id      String       @id @default(uuid()) @map("id") @db.Uuid
  userId  String       @map("user_id") @db.Uuid
  eventId String       @map("event_id") @db.Uuid
  role    UserRoleType @map("role")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("user_event_role")
  @@schema("event")
}

enum UserRoleType {
  ADMIN
  SECURITY
  GUEST

  @@schema("event")
}

enum EventCategory {
  GENERAL
  KONFERENZ
  MUSIK
  WORKSHOP
  SOCIAL
  SPORTS

  @@schema("event")
}

model Media {
  id       String @id @default(uuid()) @map("id") @db.Uuid
  key      String @unique
  url      String
  filename String
  mimetype String
  size     Int?

  type MediaType @default(GALLERY)

  eventId String @db.Uuid
  event   Event  @relation("EventMedia", fields: [eventId], references: [id], onDelete: Cascade)
  
  coverFor Event[] @relation("EventCover")
  logoFor  Event[] @relation("EventLogo")

  variants MediaVariant[]

  createdAt DateTime @default(now())

  @@map("media")
  @@index([eventId])
  @@schema("event")
}

model MediaVariant {
  id String @id @default(uuid()) @db.Uuid

  mediaId String @db.Uuid
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  key    String
  url    String
  width  Int
  height Int
  format String

  @@unique([mediaId, width, format])
  @@index([mediaId])
  @@map("media_variant")
  @@schema("event")
}

enum MediaType {
  COVER
  LOGO
  GALLERY

  @@schema("event")
}

enum InvitationApprovalMode {
  MANUAL
  AUTO
  AUTO_PUBLIC_ONLY
  AUTO_INVITE_ONLY

  @@schema("event")
}